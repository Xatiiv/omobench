{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omobench.com/schema/benchmark-run-v1.json",
  "title": "OmoBench benchmark run v1",
  "description": "The normalized, reproducible result summary submitted alongside raw benchmark evidence. Version 1.0 is the original contract, unchanged. Version 1.1 adds serving-environment, transport, weight-identity and tokenizer-identity metadata. Every 1.1-only property is forbidden on a 1.0 result, so a stored 1.0 bundle keeps exactly the meaning it was written with and never acquires a fact nobody collected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "configuration_fingerprint",
    "model",
    "runtime",
    "hardware",
    "benchmark",
    "results",
    "artifacts",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"],
      "description": "1.0 is the original contract. 1.1 adds environment (runner, serving, transport) and model.served_model_id / model.weights / model.tokenizer / model.catalog_status. A 1.0 result is never upgraded in place: an absent fact stays unknown rather than being reconstructed."
    },
    "run_id": {
      "type": "string",
      "description": "Unique ID for this individual execution session.",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "configuration_fingerprint": {
      "type": "string",
      "description": "SHA-256 of normalized model (including source, when supplied), runtime, hardware, driver, arguments, and profile metadata. Deliberately excludes the top-level execution_device: hardware.gpus (always empty for a cpu run) already separates cpu and gpu configurations, so a legacy result predating execution_device and a freshly packaged, otherwise-identical gpu result still fingerprint identically.",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "execution_device": {
      "type": "string",
      "enum": ["cpu", "gpu"],
      "description": "What performed inference for this run: cpu or gpu. This is a contributor declaration, not independent proof of execution. Absent on results published before execution-device tracking; those are treated as gpu for backward compatibility."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_version", "relationship", "runner", "serving", "transport"],
      "description": "Schema 1.1 only. Separates the environment that ran the benchmark from the environment that served the model, and records how requests travelled between them. Absent on a 1.0 result, where none of it was ever collected.",
      "properties": {
        "metadata_version": { "const": "serving-environment-v1" },
        "relationship": {
          "enum": ["same-host", "windows-host-wsl-runner"],
          "description": "How the two environments are arranged. 'same-host': one machine and one operating system did both. 'windows-host-wsl-runner': the model server runs on the Windows host and the benchmark runner runs in a WSL2 distribution on that host. Any other arrangement is not representable here and is not supported for publication."
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "kind"],
          "description": "The machine and operating system that ran GuideLLM. On a bridged run this is the WSL2 distribution, and it is deliberately not the serving hardware: what WSL can see about its host is not evidence about what served the model.",
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["native", "wsl2"] },
            "python_version": { "type": ["string", "null"], "minLength": 1 },
            "cpu": { "type": ["string", "null"], "minLength": 1 },
            "ram_gb": { "type": ["number", "null"], "exclusiveMinimum": 0 }
          }
        },
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "accelerators", "placement", "runtime"],
          "properties": {
            "host": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "cpu", "ram_gb"],
              "properties": {
                "os": { "$ref": "#/$defs/fact_string" },
                "cpu": { "$ref": "#/$defs/fact_string" },
                "ram_gb": { "$ref": "#/$defs/fact_number" }
              }
            },
            "accelerators": {
              "type": "array",
              "maxItems": 16,
              "items": { "$ref": "#/$defs/accelerator" },
              "description": "Every accelerator this evidence can say something about, each with its own role and provenance. A device that did not perform inference is listed with role 'present-not-used' or 'unknown' rather than omitted or promoted."
            },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "provenance"],
              "properties": {
                "mode": {
                  "enum": ["cpu-only", "gpu-only", "cpu-gpu-offload", "unknown"],
                  "description": "Where the weights were executed. 'cpu-gpu-offload' means some layers ran on CPU and some on one or more accelerators; detail then carries the split as the serving runtime stated it."
                },
                "detail": { "type": ["string", "null"], "minLength": 1 },
                "provenance": { "$ref": "#/$defs/provenance" }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine"],
              "properties": {
                "application": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["name", "version", "provenance"],
                  "description": "The desktop application hosting the engine, where there is one. LM Studio's release version is not the llama.cpp build inside it; both are kept, and neither is recorded as the other.",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 },
                    "provenance": { "$ref": "#/$defs/provenance" }
                  }
                },
                "engine": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version", "provenance"],
                  "description": "The inference engine that executed the weights, and its build. When its version is known it is the same version as runtime.version.",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": ["string", "null"], "minLength": 1 },
                    "provenance": { "$ref": "#/$defs/provenance" }
                  }
                },
                "settings": {
                  "type": "array",
                  "maxItems": 32,
                  "description": "Serving settings that change the measurement: context length, how many layers were given to the GPU, batch size.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "value", "provenance"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "value": { "type": "string" },
                      "provenance": { "$ref": "#/$defs/provenance" }
                    }
                  }
                }
              }
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "protocol", "overhead"],
          "properties": {
            "kind": { "enum": ["direct", "windows-wsl-stdio-bridge"] },
            "protocol": { "type": "string", "minLength": 1 },
            "bridge_version": { "type": ["string", "null"], "minLength": 1 },
            "overhead": {
              "enum": ["none-direct", "included-not-measured"],
              "description": "'included-not-measured': the transport's own latency is inside every measured number here and has not been separated out. It is never subtracted."
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "quantization"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "description": "Canonical catalog model identity, used for eligibility and comparison. Independent of source: it never changes when source is present or absent."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable model revision or commit SHA. Mutable labels such as main, master, or latest are rejected by registry validation. When source is present, this revision refers to source's own repository; it is not presented as a verified revision of id's canonical upstream repository."
        },
        "quantization": { "type": ["string", "null"] },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "The actual weights source, ideally the exact download URL pinned to an immutable revision and filename (for example a quantized re-export repository distinct from id's canonical repository). Optional: absent on results that predate this field, and on any result where the operator did not supply one; both remain valid and keep their existing interpretation, with revision then understood as id's own repository."
        },
        "served_model_id": {
          "type": "string",
          "minLength": 1,
          "description": "Schema 1.1 only. The identifier sent to the server's API, exactly as the server answers to it: an LM Studio alias such as 'deepseek-r1-distill-qwen-14b', for example. It is a serving alias, not an identity claim. model.id stays the canonical identity and is never derived from this string without a person choosing it."
        },
        "catalog_status": {
          "enum": ["catalogued", "proposed"],
          "description": "Schema 1.1 only. 'proposed' means model.id is not yet in catalog/models and this bundle carries a model proposal for review. A proposal never makes a model catalogued."
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity"],
          "description": "Schema 1.1 only. Where the bytes actually came from, kept apart from the canonical model id. A repository commit and a file checksum are different things here and are never interchanged.",
          "properties": {
            "kind": { "enum": ["repository", "local-files"] },
            "repository": { "type": ["string", "null"], "format": "uri" },
            "repository_revision": {
              "type": ["string", "null"],
              "minLength": 1,
              "description": "An immutable commit of repository. Never a file checksum, and never a label that moves."
            },
            "identity": {
              "enum": ["repository-revision", "content-hash"],
              "description": "Which route establishes this weight set: a pinned repository commit, or a hash over the bytes of the selected files for weights that have no public immutable revision."
            },
            "content": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["manifest_sha256", "files"],
              "description": "The weight files themselves, each hashed from its own bytes. A sharded model lists every shard; manifest_sha256 covers the whole ordered set, so one shard differing is a different weight set rather than the same one with a footnote. A filename is never evidence of content.",
              "properties": {
                "manifest_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "bytes", "sha256"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "bytes": { "type": "integer", "minimum": 0 },
                      "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
                    }
                  }
                }
              }
            }
          }
        },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "kind", "loaded", "matches_served_weights"],
          "description": "Schema 1.1 only. The tokenizer that built and counted this workload, recorded because it decides the token numbers being compared.",
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["huggingface", "local-directory", "served-model-default"] },
            "loaded": {
              "enum": ["loaded-before-run", "not-checked"],
              "description": "'loaded-before-run': OmoBench loaded this tokenizer in the runner's own interpreter before the benchmark started. 'not-checked': nothing loaded it here."
            },
            "matches_served_weights": {
              "const": "not-verifiable-here",
              "description": "Kept explicit so that a successful load is never read as a match. A tokenizer that loads is not thereby the tokenizer the served weights were trained with, and nothing available to OmoBench can establish that it is."
            },
            "identity": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "class": { "type": ["string", "null"], "minLength": 1 },
                "vocabulary_size": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "version", "arguments", "endpoint_type"],
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["vllm", "sglang", "llama.cpp", "lmstudio", "openai-compatible-other"]
        },
        "version": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "endpoint_type": { "const": "openai-compatible" },
        "container_image": { "type": ["string", "null"] },
        "server_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Required when framework is openai-compatible-other; free-text description of the server. Must contain at least one non-whitespace character."
        }
      },
      "if": {
        "properties": { "framework": { "const": "openai-compatible-other" } },
        "required": ["framework"]
      },
      "then": {
        "required": ["server_description"]
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "cpu", "ram_gb", "gpus", "driver_version", "detection"],
      "properties": {
        "os": { "type": "string" },
        "cpu": { "type": "string" },
        "ram_gb": { "type": "number", "exclusiveMinimum": 0 },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "memory_gb", "count"],
            "properties": {
              "vendor": {
                "type": "string",
                "enum": ["nvidia", "amd", "intel", "other"],
                "description": "Optional GPU vendor. Absent on results published before vendor-neutral detection; never required, so old published results remain valid."
              },
              "model": { "type": "string" },
              "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "driver_version": { "type": ["string", "null"] },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hardware", "model", "runtime"],
          "properties": {
            "hardware": { "enum": ["auto", "user-confirmed", "manual"] },
            "model": { "enum": ["user-confirmed", "manual"] },
            "runtime": { "enum": ["auto", "user-confirmed", "manual"] }
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "runner", "runner_version"],
      "properties": {
        "profile_id": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" },
        "profile_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "runner": { "const": "guidellm" },
        "runner_version": { "type": "string" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "latency_ms", "output_tokens_per_second", "total_tokens_per_second", "requests_per_second", "error_rate_percent"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempted", "succeeded", "failed"],
          "properties": {
            "attempted": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ttft", "inter_token"],
          "properties": {
            "ttft": { "$ref": "#/$defs/percentiles" },
            "inter_token": { "$ref": "#/$defs/percentiles" }
          }
        },
        "output_tokens_per_second": { "type": "number", "minimum": 0 },
        "total_tokens_per_second": { "type": "number", "minimum": 0 },
        "requests_per_second": { "type": "number", "minimum": 0 },
        "error_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_peak_gb": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_runner_output", "runner_stdout_log", "environment_snapshot", "reproduce_markdown"],
      "properties": {
        "raw_runner_output": { "$ref": "#/$defs/artifact" },
        "runner_stdout_log": { "$ref": "#/$defs/artifact" },
        "environment_snapshot": { "$ref": "#/$defs/artifact" },
        "reproduce_markdown": { "$ref": "#/$defs/artifact" }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submitter", "run_kind"],
      "properties": {
        "submitter": { "type": "string", "minLength": 1 },
        "run_kind": { "enum": ["initial", "repeat", "replication"] },
        "repeat_of_run_id": { "type": ["string", "null"] },
        "source_commit": { "type": ["string", "null"] },
        "packaging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metadata_declared_after_execution"],
          "description": "Schema 1.1 only. Present when a completed run was packaged again later from its saved evidence, so a reader can tell metadata that was collected while the benchmark ran from metadata a person supplied afterwards.",
          "properties": {
            "metadata_declared_after_execution": {
              "type": "boolean",
              "description": "true when the serving metadata was supplied after the run finished. Nothing declared then is recorded as detected, because no probe was running at the time to detect it."
            },
            "derived_from_run_id": { "type": ["string", "null"], "minLength": 1 },
            "evidence_sha256": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "description": "The original evidence files, hashed where they sit, so the derived bundle can be shown to carry the same measurements rather than new ones."
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "not": { "required": ["environment"] },
        "properties": {
          "model": {
            "allOf": [
              { "not": { "required": ["served_model_id"] } },
              { "not": { "required": ["weights"] } },
              { "not": { "required": ["tokenizer"] } },
              { "not": { "required": ["catalog_status"] } }
            ]
          },
          "submission": { "not": { "required": ["packaging"] } }
        }
      },
      "else": { "required": ["environment"] }
    },
    {
      "if": {
        "required": ["model"],
        "properties": { "model": { "required": ["weights"] } }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "weights": {
                "allOf": [
                  {
                    "if": {
                      "properties": { "identity": { "const": "content-hash" } },
                      "required": ["identity"]
                    },
                    "then": {
                      "required": ["content"],
                      "properties": { "content": { "type": "object" } }
                    },
                    "else": {
                      "required": ["repository", "repository_revision"],
                      "properties": {
                        "repository": { "type": "string" },
                        "repository_revision": { "type": "string" }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": { "kind": { "const": "local-files" } },
                      "required": ["kind"]
                    },
                    "then": { "properties": { "identity": { "const": "content-hash" } } }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["environment"],
        "properties": {
          "environment": {
            "required": ["transport"],
            "properties": {
              "transport": {
                "required": ["kind"],
                "properties": { "kind": { "const": "windows-wsl-stdio-bridge" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "relationship": { "const": "windows-host-wsl-runner" },
              "runner": { "properties": { "kind": { "const": "wsl2" } } },
              "transport": {
                "required": ["bridge_version"],
                "properties": {
                  "bridge_version": { "type": "string" },
                  "overhead": { "const": "included-not-measured" }
                }
              }
            }
          }
        }
      },
      "else": {
        "if": { "required": ["environment"] },
        "then": {
          "properties": {
            "environment": {
              "properties": {
                "relationship": { "const": "same-host" },
                "runner": { "properties": { "kind": { "const": "native" } } },
                "transport": {
                  "properties": {
                    "overhead": { "const": "none-direct" },
                    "bridge_version": { "type": "null" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "execution_device": { "const": "cpu" } },
        "required": ["execution_device"]
      },
      "then": {
        "properties": {
          "hardware": {
            "properties": {
              "gpus": {
                "maxItems": 0,
                "description": "Must be empty for a cpu run: no GPU performed inference. Detected-but-unused hardware belongs in the environment snapshot artifact, not here."
              },
              "driver_version": { "const": null }
            }
          }
        }
      },
      "else": {
        "properties": {
          "hardware": {
            "properties": {
              "gpus": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "enum": ["detected", "server-reported", "contributor-declared", "unknown"],
      "description": "How this one fact was established. 'detected': a probe running on the machine that owns the fact read it. 'server-reported': the inference server itself reported it over its own API. 'contributor-declared': a person typed it. 'unknown': nobody established it, and the value is then null. A fact is never upgraded between these, however plausible it looks."
    },
    "fact_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "description": "A string fact with its origin. A null value and 'unknown' always travel together: a value with nothing behind it would be invented, and an 'unknown' that still carried a value would be laundered of its origin.",
      "properties": {
        "value": { "type": ["string", "null"], "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "if": { "properties": { "value": { "type": "null" } } },
      "then": { "properties": { "provenance": { "const": "unknown" } } },
      "else": { "properties": { "provenance": { "not": { "const": "unknown" } } } }
    },
    "fact_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "if": { "properties": { "value": { "type": "null" } } },
      "then": { "properties": { "provenance": { "const": "unknown" } } },
      "else": { "properties": { "provenance": { "not": { "const": "unknown" } } } }
    },
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "memory_gb", "count", "role", "provenance"],
      "properties": {
        "vendor": { "enum": ["nvidia", "amd", "intel", "apple", "other"] },
        "model": { "type": "string", "minLength": 1 },
        "memory_gb": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "role": {
          "enum": ["inference", "present-not-used", "unknown"],
          "description": "What this device did for this run. 'inference' is a claim about execution, not about presence: detecting a card establishes the card, not that inference touched it, so a detected device nothing ties to the run is 'present-not-used' or 'unknown'."
        },
        "provenance": {
          "$ref": "#/$defs/provenance",
          "description": "How the device facts here (vendor, model, memory) were established. It says nothing about role, which is always a separate claim."
        }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
