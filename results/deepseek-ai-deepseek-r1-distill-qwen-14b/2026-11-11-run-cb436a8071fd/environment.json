      "state": "none",
      "observed_seconds": 0,
      "longest_seconds": 0.0,
      "events": [],
      "method": "CLOCK_BOOTTIME and the wall clock against CLOCK_MONOTONIC, sampled every 1s while measuring"
    },
    "sleep_prevention": {
      "requested": true,
      "held": true,
      "mechanism": "windows-power-request-v1",
